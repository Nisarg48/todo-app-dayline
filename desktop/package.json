{
  "name": "dayline-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Dayline desktop app",
  "author": { "name": "Nisarg Patel", "email": "nisargdp48@gmail.com" },
  "homepage": "https://github.com/Nisarg48/todo-app-dayline",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "NODE_ENV=development electron .",
    "start": "NODE_ENV=production electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.dayline.app",
    "productName": "Dayline",
    "asar": false,
    "files": ["main.js", "staged/**/*"],
    "win": { "target": ["nsis"] },
    "mac": { "target": ["dmg"] },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "maintainer": "Nisarg Patel <nisargdp48@gmail.com>",
      "description": "Dayline — day-wise daily planner",
      "executableArgs": ["--no-sandbox"]
    },
    "deb": { "afterInstall": "build/after-install.sh" }
  }
}
